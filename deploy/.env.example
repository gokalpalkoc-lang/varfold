# Public hostname; Caddy obtains the TLS certificate automatically.
DOMAIN=varfold.example.com

# Live folding through Tailscale. Leave VARFOLD_WORKER_URL empty to run the
# site purely from the precomputed dataset.
VARFOLD_WORKER_URL=http://100.64.0.10:8100
# Same value as VARFOLD_WORKER_TOKEN on the research PC (openssl rand -hex 32).
VARFOLD_WORKER_TOKEN=
VARFOLD_LIVE_PER_HOUR=6
VARFOLD_LIVE_MAX_LENGTH=400
VARFOLD_WORKER_TIMEOUT=300
