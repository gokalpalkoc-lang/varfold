{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		-Server
	}

	# The app itself needs nothing from third parties.
	@app not path /api/docs
	header @app Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

	# FastAPI's interactive docs load Swagger UI from jsDelivr.
	@docs path /api/docs
	header @docs Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; frame-ancestors 'none'"

	# Requests are tiny (a sequence of at most a few hundred letters); refuse anything large
	# before it reaches the app, which would otherwise buffer the body before validating it.
	request_body {
		max_size 64KB
	}

	reverse_proxy app:8000 {
		# Live folds can take a while on a busy GPU.
		transport http {
			read_timeout 6m
		}
	}
}
