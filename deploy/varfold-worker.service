# systemd *user* unit for the live inference worker on the research PC.
#   mkdir -p ~/.config/varfold ~/.config/systemd/user
#   printf 'VARFOLD_WORKER_TOKEN=%s\n' "$(openssl rand -hex 32)" > ~/.config/varfold/worker.env
#   chmod 600 ~/.config/varfold/worker.env
#   (paths assume the repo is cloned to ~/varfold; edit WorkingDirectory/ExecStart otherwise)
#   cp deploy/varfold-worker.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now varfold-worker
#   loginctl enable-linger "$USER"     # keep it running while logged out
#
# The worker and `varfold fold` share one 8 GB GPU: stop the worker
# (systemctl --user stop varfold-worker) before an overnight batch run.

[Unit]
Description=VarFold live ESMFold worker (Tailscale only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/varfold
EnvironmentFile=%h/.config/varfold/worker.env
# Bind to the Tailscale address only, so the worker is unreachable from the LAN/Internet.
ExecStart=/bin/sh -c 'exec %h/varfold/.venv/bin/varfold serve --host "$(tailscale ip -4)" --port 8100'
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
